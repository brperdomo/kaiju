{
  "name": "kaiju",
  "version": "0.1.0",
  "private": true,
  "description": "Kaiju: a local, Jira Cloud-compatible mock (REST v3/v2 subset, Jira-style automation, Jira-like UI) for POCs, demos and integration tests.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
